# Database
POSTGRES_USER=veetrack
POSTGRES_PASSWORD=changeme
POSTGRES_DB=veetrack
DATABASE_URL=postgresql+asyncpg://veetrack:changeme@localhost:5432/veetrack

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth
JWT_SECRET=changeme-replace-with-a-long-random-secret

# LLM — local Ollama tier (qwen2.5:7b, ~2 GB)
# Start with: ollama serve  (runs as background daemon automatically)
# Pull model: ollama pull qwen2.5:7b
LLM_LOCAL_BASE_URL=http://localhost:11434/v1
LLM_LOCAL_ENDPOINT=http://localhost:11434/v1/chat/completions
LLM_LOCAL_MODEL=qwen2.5:7b
# LLM — hosted tier (Anthropic Claude, optional)
ANTHROPIC_API_KEY=
LLM_HOSTED_MODEL=claude-haiku-4-5-20251001

# External API Keys
NEWSDATA_API_KEY=your_newsdata_api_key_here
TWITTERAPI_IO_KEY=your_twitterapi_io_key_here
API_DIRECT=
