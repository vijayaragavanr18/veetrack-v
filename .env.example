# Database
POSTGRES_USER=veetrack
POSTGRES_PASSWORD=changeme
POSTGRES_DB=veetrack
DATABASE_URL=postgresql+asyncpg://veetrack:changeme@localhost:5432/veetrack

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth
JWT_SECRET=changeme-replace-with-a-long-random-secret

# LLM — local vLLM tier (Qwen2.5-3B-Instruct-AWQ, ~2.1 GB)
LLM_LOCAL_ENDPOINT=http://localhost:8080/v1/chat/completions
LLM_LOCAL_MODEL=Qwen/Qwen2.5-3B-Instruct-AWQ
# LLM — hosted tier (Anthropic Claude, optional when using local)
ANTHROPIC_API_KEY=
