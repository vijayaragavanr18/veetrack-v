{
  "title": "VeeTrack Operations",
  "uid": "veetrack-ops",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "API Request Rate (req/s)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "rate(http_requests_total[1m])",
          "legendFormat": "{{method}} {{handler}} {{status_code}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "API P95 Latency (s)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket[5m]))",
          "legendFormat": "p95 {{handler}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Celery Tasks Started / Succeeded / Failed",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "rate(celery_tasks_started_total[1m])",
          "legendFormat": "started {{task_name}}"
        },
        {
          "expr": "rate(celery_tasks_succeeded_total[1m])",
          "legendFormat": "succeeded {{task_name}}"
        },
        {
          "expr": "rate(celery_tasks_failed_total[1m])",
          "legendFormat": "FAILED {{task_name}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Celery Task P95 Duration (s)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(celery_task_duration_seconds_bucket[5m]))",
          "legendFormat": "p95 {{task_name}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "API Errors Last Hour",
      "type": "stat",
      "gridPos": { "x": 0, "y": 16, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{status_code=~\"5..\"}[1h]))",
          "legendFormat": "5xx errors"
        }
      ]
    }
  ]
}
